from financial.models import Invoice, Payment, ClientLedger, ClientBalance
def test(ledger, condition, msg=""):
    status = "PASS" if condition else "FAIL"
    print( f"[{status}] {ledger}")
    if not condition:
        print( f"       {msg}")
def print_balances():
    print( "\n" + "=" * 70)
    print( "CLIENT BALANCES")
    print( "=" * 70)
    for cb in ClientBalance.objects.select_related('client').all():
        print( f"  {cb.client.name:25} | Invoiced: {cb.total_ledger_cost:>10} | Paid: {cb.total_ledger:>10} | Pending: {cb.ledger_balance:>10}")
    print()
